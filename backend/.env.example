# General Environment Variables
ENVIRONMENT=development
DATA_DIR=/absolute/path/to/Glyphflow/.dev-data
ALLOW_INSECURE_TRANSPORT=true
WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=*
CSRF_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_BYTES=1048576

# Database
# GLYPHFLOW_DATABASE=sqlite (local dev - default), psql/postgresql (recommended for PRD)
GLYPHFLOW_DATABASE=sqlite
# Optional for SQLite. Defaults to DATA_DIR/controlplane.sqlite.
DATABASE_URL=
# For PostgreSQL, use for example:
# GLYPHFLOW_DATABASE=postgresql
# DATABASE_URL=postgresql://user:password@host:5432/glyphflow?sslmode=verify-full
# PGSSLROOTCERT=/path/to/postgres-ca.pem

# NATS
# GLYPHFLOW_NATS=embed (alias: embedded, local dev - default), remote (recommended for PRD)
GLYPHFLOW_NATS=embed
# Required when GLYPHFLOW_NATS=remote. Leave empty for embedded NATS.
NATS_URL=
NATS_CERT_FILE=
NATS_KEY_FILE=
NATS_CA_FILE=

# Control-plane security
ACCESS_TOKEN_SECRET=replace-with-at-least-32-bytes
PASSWORD_PEPPER=replace-with-at-least-16-bytes
SECRET_ENCRYPTION_KEY_FILE=
CONTROL_PLANE_SIGNING_PRIVATE_KEY=

# Authentication and bootstrap
ENABLE_PASSWORD_LOGIN=true
ENABLE_PASSWORD_REGISTRATION=true
REQUIRE_USER_APPROVAL=true
DEFAULT_ROLE_ID=system-user
GLYPHFLOW_SYSTEM_ADMINS=admin@example.com
GLYPHFLOW_BOOTSTRAP_EMAIL=admin@example.com
GLYPHFLOW_BOOTSTRAP_PASSWORD=replace-me
GLYPHFLOW_BOOTSTRAP_OIDC_PROVIDER=
GLYPHFLOW_BOOTSTRAP_OIDC_SUBJECT=

# Control-plane retention and storage monitoring
LOG_MONTHS_KEEP=3
AUDIT_MONTHS_KEEP=12
RUNNER_METRICS_MONTHS_KEEP=3
DATABASE_STORAGE_CAPACITY_BYTES=1073741824

# Worker settings
# Enrollment artifacts provide NATS_URL automatically. For a local worker on
# the same machine as the control plane, keep GLYPHFLOW_NATS=embed. Use
# GLYPHFLOW_NATS_ENDPOINT only when the embedded endpoint needs an override.
RUNNER_ID=worker-1
MAX_OUTPUT_BYTES=1048576
GLYPHFLOW_NATS_ENDPOINT=
GLYPHFLOW_CONTROL_PLANE_URL=http://localhost:8080
RUNNER_NATS_URL=
RUNNER_CONTROL_PLANE_URL=http://localhost:8080
RUNNER_BINARIES_DIR=./runner-binaries

# Container deployment controls (Compose only)
# GLYPHFLOW_PORT=80
# GLYPHFLOW_DISABLE_NGINX=false
# DATABASE_URL_FILE=/path/to/database-url
# NATS_URL_FILE=/path/to/nats-url
# ACCESS_TOKEN_SECRET_FILE=/path/to/access-token-secret
# PASSWORD_PEPPER_FILE=/path/to/password-pepper
# CONTROL_PLANE_SIGNING_PRIVATE_KEY_FILE=/path/to/control-plane-signing-key
# GLYPHFLOW_BOOTSTRAP_PASSWORD_FILE=/path/to/bootstrap-password
