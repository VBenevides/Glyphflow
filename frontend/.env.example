# Frontend environment variables
# Backend URL used by the Vite development proxy. Copy this file to .env.
VITE_BACKEND_URL=http://localhost:8080

# VITE_APP_VERSION is injected from VERSION during the build.

# Browser acceptance tests (optional)
# GLYPHFLOW_URL=http://localhost:5173
# GLYPHFLOW_CDP_URL=http://127.0.0.1:9222
# GLYPHFLOW_ADMIN_EMAIL=admin@domain.com
# GLYPHFLOW_ADMIN_PASSWORD=password
# GLYPHFLOW_STARTUP_RUNS=5
